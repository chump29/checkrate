{
  "name": "@postfmly/checkrate",
  "version": "2.0.15",
  "description": "Rate limiter",
  "keywords": [
    "rate",
    "limiter"
  ],
  "homepage": "https://github.com/chump29/checkrate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/checkrate.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run --bun bunup",
    "deps": "bunx --bun depcheck --ignores=\"@postfmly/config,@types/*,bun:*,lcov-total\"",
    "env": "bun run --bun env.ts",
    "env:test": "NODE_ENV=test bun run env",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run lint:spell && bun run lint:ts && bun run lint:biome",
    "lint:biome": "bun run --bun biome check --write --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot .",
    "lint:ts": "bun check",
    "prepare": "bun run --bun lefthook install",
    "prepare:commit": "bun run --bun lefthook run pre-commit",
    "scan": "bun run scan:audit && bun run scan:cve && bun run scan:dupe",
    "scan:audit": "bun audit --production",
    "scan:cve": "bun run --bun cve-lite --check-overrides --check-network --check-maintenance --prod-only --only-used",
    "scan:dupe": "bun dedupe --check",
    "test": "bun test --isolate --dots --bail --check",
    "test:coverage": "bun test --isolate --dots --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail --check",
    "test:coverage:full": "TEST_FULL=true bun test --isolate --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail --check",
    "test:full": "TEST_FULL=true bun test --isolate --bail --check",
    "updates": "bunx --bun npm-check-updates --dep overrides,prod,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "overrides": {
    "undici-types": "8.13.1"
  },
  "dependencies": {
    "@jarrodek/pluralize": "^1.0.2",
    "@lukeed/ms": "^2.0.2",
    "@postfmly/logger": "^1.2.9",
    "envalid": "^9.0.0"
  },
  "devDependencies": {
    "@postfmly/config": "^1.6.41",
    "bunup": "^0.16.32",
    "cve-lite-cli": "^1.42.0",
    "lcov-total": "^2.1.1",
    "lefthook": "^2.2.2"
  },
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": "^1.4.5"
  },
  "engineStrict": true,
  "cpu": [
    "x64",
    "arm64"
  ],
  "patchedDependencies": {
    "@lukeed/ms@2.0.2": "patches/@lukeed%2Fms@2.0.2.patch"
  }
}
