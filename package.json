{
  "name": "@postfmly/checkrate",
  "version": "1.0.12",
  "description": "Discord rate limiter",
  "keywords": [
    "discord",
    "rate",
    "limiter"
  ],
  "homepage": "https://github.com/chump29/checkrate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/checkrate.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "bun run build:clean && bun run build:build && bun run build:dts && bun run build:copy && bun run build:rm",
    "build:build": "bun run --bun build.ts",
    "build:clean": "bun run --bun rimraf dist",
    "build:copy": "cp -f LICENSE package.json README.md dist/",
    "build:dts": "bun run --bun tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false --skipLibCheck",
    "build:rm": "bun run --bun rimraf dist/build.d.ts dist/tests",
    "check": "bunx --bun depcheck --ignores=\"@types/*,bun,bun:*,html-validate,lcov-total,rimraf,stylelint-config-standard\" || :",
    "clean": "bun run --bun rimraf bun.lock dist tests/coverage",
    "lint": "bun run lint:spell && bun run lint:biome && bun run lint:env && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:ci": "bun run --bun biome check ci --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:env": "bun run --bun dotenv-linter check .",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "lint:ts": "bun run --bun tsc",
    "preinstall": "bunx --bun only-allow bun",
    "scan": "bun audit && bun run --bun cve-lite --check-overrides",
    "test": "bun test --isolate --bail",
    "test:coverage": "bun test --isolate --dots --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:coverage:full": "bun test --isolate --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail"
  },
  "overrides": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "cspell": "10.0.1",
    "cve-lite-cli": "1.29.0",
    "globals": "17.11.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "discord.js-rate-limiter": "^1.3.2",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/ms": "^2.1.0",
    "lcov-total": "^2.1.1",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "@postfmly/config": "^1.4.44",
    "@postfmly/logger": "^1.0.25",
    "discord.js": "^14.27.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "~1.3.14"
  },
  "engineStrict": true
}
