{
  "name": "@postfmly/checkrate",
  "version": "2.0.7",
  "description": "Rate limiter",
  "keywords": [
    "rate",
    "limiter"
  ],
  "homepage": "https://github.com/chump29/checkrate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/checkrate.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run --bun bunup",
    "deps": "bunx --bun depcheck --ignores=\"@postfmly/config,@types/*,bun:*,lcov-total\"",
    "env": "bun run --bun env.ts",
    "env:test": "NODE_ENV=test bun run --bun env.ts",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run lint:spell && bun run lint:biome && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot .",
    "lint:ts": "bun check",
    "prepare": "bun run --bun husky",
    "scan": "bun run scan:audit && bun run scan:cve && bun run scan:dupe",
    "scan:audit": "bun audit --production",
    "scan:cve": "bunx --bun cve-lite-cli --check-overrides --check-network --check-maintenance --prod-only --only-used",
    "scan:dupe": "bun dedupe --check",
    "test": "bun test --isolate --dots --bail",
    "test:coverage": "bun test --isolate --dots --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:coverage:full": "bun test --isolate --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:full": "bun test --isolate --bail",
    "updates": "bunx --bun npm-check-updates --dep overrides,prod,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "lint-staged": {
    "*.{json,ts}": "bun run --bun biome ci --no-errors-on-unmatched --error-on-warnings"
  },
  "overrides": {
    "undici-types": "8.12.3"
  },
  "dependencies": {
    "@jarrodek/pluralize": "^1.0.2",
    "@lukeed/ms": "^2.0.2",
    "@postfmly/logger": "^1.2.4",
    "dayjs": "^1.11.23",
    "envalid": "^8.2.0"
  },
  "devDependencies": {
    "@postfmly/config": "^1.6.13",
    "@postfmly/types": "^1.0.9",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "lcov-total": "^2.1.1",
    "lint-staged": "^17.6.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "^1.4.4"
  },
  "engineStrict": true,
  "patchedDependencies": {
    "@lukeed/ms@2.0.2": "patches/@lukeed%2Fms@2.0.2.patch"
  }
}
